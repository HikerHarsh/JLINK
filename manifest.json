{
  "manifest_version": 3,
  "name": "JDownloader Web UI (Open Source)",
  "version": "1.1",
  "description": "Detects HTML5 videos and embedded iframes, sending them to JDownloader seamlessly.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["assets/styles.css"],
      "js": ["src/content/drag.js", "src/content/widget.js", "src/content/content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
